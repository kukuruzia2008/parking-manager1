# Supabase Auth and per-user cloud sync. Copy this file to .env.local and fill your project values.
# Use the publishable key (or legacy anon key). NEVER put service_role / secret keys in frontend code.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional compatibility with older Supabase projects:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Optional server-side AI support endpoint. The API key must stay on your server.
VITE_AI_SUPPORT_ENDPOINT=

# Optional: your own OSRM server base URL (without trailing slash)
VITE_ROUTING_BASE_URL=https://router.project-osrm.org
